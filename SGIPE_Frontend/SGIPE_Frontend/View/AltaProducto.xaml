<Window x:Class="SGIPE_Frontend.Views.AltaProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta Producto"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2575BB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2575BB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#2575BB" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="450" VerticalAlignment="Center"
                Background="White"
                CornerRadius="25"
                BorderBrush="#2575BB"
                BorderThickness="8"
                Padding="30">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#2575BB" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="ALTA DE PRODUCTO"
                           FontSize="24"
                           FontWeight="ExtraBold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Nombre del Producto" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtNombre"/>

                <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtDescripcion"/>

                <TextBlock Text="Categoría" Style="{StaticResource LabelStyle}"/>
                <ComboBox Name="cmbCategoria"/>

                <TextBlock Text="Stock inicial" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtStock"/>

                <TextBlock Text="Precio de Venta" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtPrecio"/>

                <Button Content="GUARDAR PRODUCTO"
                        Name="btnGuardar"
                        Margin="0,25,0,0"
                        Click="BtnGuardar_Click"
                        Background="#2575BB" 
                        Foreground="White"/>

                <Button Content="REGRESAR"
                        Margin="0,10,0,0"
                        Click="BtnRegresar_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>