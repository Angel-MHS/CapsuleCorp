<Window x:Class="SGIPE_Frontend.Views.BajaProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baja Producto"
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="BtnEliminarStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2575BB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="BtnRegresarStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2575BB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2575BB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#2575BB" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="650"
                Background="White"
                CornerRadius="25"
                BorderBrush="#2575BB"
                BorderThickness="8"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#2575BB" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="ELIMINAR PRODUCTO"
                           FontSize="24"
                           FontWeight="ExtraBold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <DataGrid Name="dataGridProductos"
                          AutoGenerateColumns="False"
                          Height="230"
                          Background="White"
                          BorderBrush="#DDDDDD"
                          RowBackground="#FDFDFD"
                          AlternatingRowBackground="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                        <DataGridTextColumn Header="Nombre del Producto" Binding="{Binding nombre}" Width="*"/>
                        <DataGridTextColumn Header="Stock Actual" Binding="{Binding stock}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Separator Height="10" Visibility="Hidden"/>

                <Button Content="ELIMINAR SELECCIONADO"
                        Style="{StaticResource BtnEliminarStyle}"
                        Click="BtnEliminar_Click"/>

                <Button Content="REGRESAR"
                        Style="{StaticResource BtnRegresarStyle}"
                        Click="BtnRegresar_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
