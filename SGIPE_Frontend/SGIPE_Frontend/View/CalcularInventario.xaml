<Window  x:Class="SGIPE_Frontend.View.CalcularInventario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calcular Inventario"
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnCalcularStyle" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#2575BB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="BtnRegresarStyle" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="#2575BB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2575BB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#2575BB" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="420"
                Background="White"
                CornerRadius="25"
                BorderBrush="#2575BB"
                BorderThickness="8"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#2575BB" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="CÁLCULO DE STOCK"
                           FontSize="24"
                           FontWeight="ExtraBold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Stock Actual" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtStock" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Cantidad a mover" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtCantidad" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Tipo de Movimiento" Style="{StaticResource LabelStyle}"/>
                <ComboBox Name="cmbTipo" SelectedIndex="0" Height="30" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Entrada"/>
                    <ComboBoxItem Content="Salida"/>
                </ComboBox>

                <Button Content="CALCULAR NUEVO TOTAL"
                        Style="{StaticResource BtnCalcularStyle}"
                        Margin="0,25,0,0"
                        Click="BtnCalcular_Click"/>

                <Border Margin="0,15,0,0" 
                        Background="#F0F7FF" 
                        CornerRadius="10" 
                        Padding="10">
                    <TextBlock Name="txtResultado"
                               Text="Esperando cálculo..."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#2575BB"
                               TextAlignment="Center"/>
                </Border>

                <Button Content="REGRESAR"
                        Style="{StaticResource BtnRegresarStyle}"
                        Margin="0,15,0,0"
                        Click="BtnRegresar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
