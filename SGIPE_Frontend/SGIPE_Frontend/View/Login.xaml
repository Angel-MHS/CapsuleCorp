<Window x:Class="SGIPE_Frontend.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CapsuleCorp - Login"
        Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#2575BB" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="380" Height="400"
                Background="White"
                CornerRadius="25"
                BorderBrush="#2575BB"
                BorderThickness="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="25">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#2575BB" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>

                <Ellipse Width="60" Height="60" Fill="#2575BB" Margin="0,0,0,10"/>

                <TextBlock Text="CAPSULE CORP."
                           Foreground="#1A1A1A"
                           FontSize="28"
                           FontWeight="ExtraBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="INGRESE USUARIO"
                           Foreground="#2575BB"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="5,0,0,2"/>

                <TextBox Name="txtUsuario"
                         Height="38"
                         Margin="0,0,0,12"
                         BorderBrush="#2575BB"
                         BorderThickness="2"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="14"/>

                <TextBlock Text="INGRESE CONTRASEÑA"
                           Foreground="#2575BB"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="5,0,0,2"/>

                <PasswordBox Name="txtPassword"
                             Height="38"
                             Margin="0,0,0,15"
                             BorderBrush="#2575BB"
                             BorderThickness="2"
                             VerticalContentAlignment="Center"
                             Padding="10,0"/>

                <Button Name="btnLogin"
                        Content="INICIAR"
                        Height="45"
                        Background="#2575BB"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="BtnLogin_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                BorderBrush="#1A1A1A"
                                                BorderThickness="0,0,0,4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder"
                                                        Property="Background"
                                                        Value="#1E5A8E"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder"
                                                        Property="BorderThickness"
                                                        Value="0"/>
                                                <Setter TargetName="btnBorder"
                                                        Property="Margin"
                                                        Value="0,4,0,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>
        </Border>
        
    </Grid>
</Window>
