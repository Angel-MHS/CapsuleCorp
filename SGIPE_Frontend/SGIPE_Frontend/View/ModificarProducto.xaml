<Window x:Class="SGIPE_Frontend.View.ModificarProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modificar Producto"
        Height="680" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnGuardarStyle" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#2575BB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="BtnRegresarStyle" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="#2575BB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2575BB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#2575BB" Offset="0"/>
                <GradientStop Color="#000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Width="930"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="25"
                BorderBrush="#2575BB"
                BorderThickness="8"
                Padding="25">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#2575BB" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="EDICIÓN DE PRODUCTO"
                           FontSize="24"
                           FontWeight="ExtraBold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="1. Seleccione el producto a modificar:"
                           FontWeight="Bold"
                           Foreground="#2575BB"
                           Margin="0,0,0,5"/>

                <DataGrid Name="dataGridProductos"
                          AutoGenerateColumns="False"
                          Height="210"
                          Background="White"
                          BorderBrush="#DDDDDD"
                          RowBackground="#FDFDFD"
                          AlternatingRowBackground="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionChanged="dataGridProductos_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding nombre}" Width="170"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding descripcion}" Width="220"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding categoriaNombre}" Width="150"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding stock}" Width="80"/>
                        <DataGridTextColumn Header="Precio Venta" Binding="{Binding precioVenta}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Separator Height="20" Background="Transparent"/>

                <TextBlock Text="2. Modifique los datos necesarios:"
                           FontWeight="Bold"
                           Foreground="#2575BB"
                           Margin="0,0,0,5"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="ID Producto" Style="{StaticResource LabelStyle}"/>
                        <TextBox Name="txtId"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F0F0F0"/>
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Nombre del Producto" Style="{StaticResource LabelStyle}"/>
                        <TextBox Name="txtNombre"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtDescripcion"
                         Height="55"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Padding="5"
                         BorderBrush="#CCCCCC"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Categoría" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Name="cmbCategoria"
                                  Style="{StaticResource InputComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Stock" Style="{StaticResource LabelStyle}"/>
                        <TextBox Name="txtStock"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Precio de Venta" Style="{StaticResource LabelStyle}"/>
                <TextBox Name="txtPrecio"
                         Style="{StaticResource InputTextBoxStyle}"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="GUARDAR CAMBIOS"
                            Style="{StaticResource BtnGuardarStyle}"
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            Click="BtnGuardar_Click"/>

                    <Button Content="REGRESAR"
                            Style="{StaticResource BtnRegresarStyle}"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Click="BtnRegresar_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>