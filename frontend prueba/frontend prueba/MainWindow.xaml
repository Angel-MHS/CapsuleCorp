<Window x:Class="frontend_prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:frontend_prueba"
        mc:Ignorable="d"
         Title="Capsule Corp - Login" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F1C">

    <Grid>
        <!-- Fondo degradado -->
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#0A0F1C" Offset="0"/>
                <GradientStop Color="#05070D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Width="350" Height="300"
                Background="#111827"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20">

            <StackPanel>

                <!-- Título -->
                <TextBlock Text="CAPSULE CORP"
                           Foreground="#00D4FF"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Usuario -->
                <TextBox Name="txtUsuario"
                         Height="35"
                         Margin="0,5"
                         Background="#1F2937"
                         Foreground="White"
                         BorderBrush="#00D4FF"
                         BorderThickness="1"
                         Padding="10"
                         Text="Usuario"/>

                <!-- Contraseña -->
                <PasswordBox Name="txtPassword"
                             Height="35"
                             Margin="0,5"
                             Background="#1F2937"
                             Foreground="White"
                             BorderBrush="#00D4FF"
                             BorderThickness="1"
                             Padding="10"/>

                <!-- Botón -->
                <Button Content="Iniciar Sesión"
                        Height="40"
                        Margin="0,20,0,0"
                        Background="#00D4FF"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

        </Border>

    </Grid>
</Window>
